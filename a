import requests
import xml.etree.ElementTree as ET

# 查询URL
url = "http://lookup.dbpedia.org/api/search/KeywordSearch?QueryClass=place&QueryString=berlin"

# 获取XML内容
response = requests.get(url, headers={'Accept': 'application/xml'})
response.raise_for_status()  # 确保请求成功

# 解析XML
root = ET.fromstring(response.text)

# 提取所有Class标签的Label
classes = set()  # 用set防止重复
for class_element in root.findall(".//Class/Label"):
    classes.add(class_element.text)

# 输出结果
print("提取的Class:")
for class_label in classes:
    print(class_label)

# 保存到文件
with open("dbpedia_classes.txt", "w", encoding="utf-8") as f:
    for class_label in classes:
        f.write(f"{class_label}\n")
