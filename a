import pandas as pd
import requests
import xml.etree.ElementTree as ET
from concurrent.futures import ThreadPoolExecutor, as_completed
from tqdm import tqdm

def fetch_class(title):
    import requests
    try:
        url = f"http://lookup.dbpedia.org/api/search/KeywordSearch?QueryString={title}"
        headers = {'Accept': 'application/xml'}
        response = requests.get(url, headers=headers, timeout=10)
        response.raise_for_status()

        root = ET.fromstring(response.text)
        first_result = root.find(".//Result")

        classes = []
        if first_result is not None:
            for class_element in first_result.findall(".//Class/Label"):
                classes.append(class_element.text)
        return classes

    except Exception as e:
        print(f"Error fetching {title}: {e}")
        return []

def parallel_fetch(titles, num_workers=10):
    from concurrent.futures import ThreadPoolExecutor
    from tqdm import tqdm

    all_classes = []

    with ThreadPoolExecutor(max_workers=num_workers) as executor:
        results = list(tqdm(executor.map(fetch_class, titles), total=len(titles)))

    return results

if __name__ == "__main__":
    import xml.etree.ElementTree as ET

    df = pd.read_csv('data.tsv', sep='\t', names=['id', 'title'，'section', 'text'])

    titles = df['title'].tolist()
    classes = parallel_fetch(titles, num_workers=10)

    df['classes'] = classes

    df.to_csv("output_with_classes.csv", index=False)

